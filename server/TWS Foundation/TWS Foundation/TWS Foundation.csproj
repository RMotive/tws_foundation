<Project Sdk="Microsoft.NET.Sdk.Web">
	
  <PropertyGroup>
	<Version>7.1.1</Version>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TWS_Foundation</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Include="CSMS.Connection\development.connection.json" Condition="$(Configuration) == Debug">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
	<None Include="CSMS.Connection\quality.connection.json" Condition="$(Configuration) == Debug">
		<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	</None>
    <None Include="Properties\server_properties.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CSM Foundation\CSM Foundation.csproj" />
    <ProjectReference Include="..\CSM Security\CSM Security.csproj" />
    <ProjectReference Include="..\TWS Business\TWS Business.csproj" />
    <ProjectReference Include="..\TWS Customer\TWS Customer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Controllers\Business\" />
  </ItemGroup>

</Project>
